rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Houses: ownerId field must match the authenticated user's UID
    match /houses/{houseId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
    }

    // Areas: owned by whoever owns the referenced house document
    match /areas/{areaId} {
      allow read, update, delete: if request.auth != null
                                  && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.ownerId == request.auth.uid;
    }

    // Issues: owned by whoever owns the referenced house document
    match /issues/{issueId} {
      allow read, update, delete: if request.auth != null
                                  && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.ownerId == request.auth.uid;
    }

    // Projects: owned by whoever owns the referenced house document
    match /projects/{projectId} {
      allow read, update, delete: if request.auth != null
                                  && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.ownerId == request.auth.uid;
    }

    // Supplies: owned by whoever owns the referenced house document
    match /supplies/{supplyId} {
      allow read, update, delete: if request.auth != null
                                  && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.ownerId == request.auth.uid;
    }
  }
}
